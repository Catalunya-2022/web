# Plausible Analytics — set to your domain to enable tracking (e.g., 2022.cat)
# Leave empty to disable analytics (dev, forks, CI).
# In production the script is served same-origin at /reset/crida.js.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Build tuning (optional) — how many OG images scripts/generate-og-images.tsx
# renders concurrently. Defaults to 8; lower it on memory-constrained machines.
#OG_BATCH_SIZE=8

# Chrome WebMCP origin trial token (optional). Origin-bound to https://2022.cat,
# so it is useless on forks or other domains; leave empty and the site-wide
# Origin-Trial header is simply omitted.
#WEBMCP_ORIGIN_TRIAL_TOKEN=
